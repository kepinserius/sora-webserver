# Rust specific ignores
/target/
**/*.rs.bk
*.pdb

# Cargo.lock should be committed for binary projects, but we'll include it here
# just in case someone decides to use this as a library
Cargo.lock

# Generated documentation
/target/doc/

# Debug artifacts
/target/debug/
*.profraw
/flamegraph.svg

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
.directory
.Trash-*
.nfs*

# Environment files
.env
.env.*
!.env.example
.direnv/

# Server-specific ignores
/logs/
/www/
/certs/*.pem
/certs/*.key
/certs/*.crt
/certs/*.cert
!/certs/README.md
/data/

# Generated configuration files
/config/*.local.toml
/config/prod.toml
/config/dev.toml

# Test artifacts
/target/tests/

# Code coverage files
/target/coverage/
*.gcda
*.gcno
*.lcov

# Generated by cargo-audit
/audit-reports/

# Build artifacts from examples
/examples/target/
/examples/node_modules/
/examples/*.log
/examples/test_upload.txt

# Docker artifacts
/.docker/
/*.tar
/docker-compose.override.yml

# Benchmark results
/benchmarks/results/

# Operating system specific files
.directory
.fuse_hidden*
.Trash-*
.nfs*

# Package manager files
package-lock.json
yarn.lock
node_modules/
npm-debug.log
yarn-error.log

# Security-related files (should never be committed)
*.pem
*.key
*.cert
*.crt
!/certs/README.md
# Allow example certs if needed for testing
!/certs/example_*/

# Backup files
*.bak
*.backup
*~
*.old

# Documentation files
tatacara.md
tatacaradeploy.md 